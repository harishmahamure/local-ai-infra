# llama-server gemma planner — copy to ~/ai-inference/config/gemma.env
MODEL_PATH=@MODELS@/gemma-4-E4B-it-Q4_K_M.gguf
MMPROJ_PATH=@MODELS@/gemma-4-E4B-mmproj-BF16.gguf
# ggml-org tree: the iso3 fork cannot load architecture 'gemma4'.
LLAMACPP_ROOT=@HOME@/llama.cpp
ENABLE_MTP=0
NGL=99
CTX=131072
# Default FP16 KV cache (not iso3).
CACHE_TYPE_K=f16
CACHE_TYPE_V=f16
FLASH_ATTN=on
TEMP=0.3
TOP_P=0.90
TOP_K=40
