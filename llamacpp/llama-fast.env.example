# llama-server fast — copy to ~/ai-inference/config/llama-fast.env
MODEL_PATH=@MODELS@/Qwen3.6-35B-A3B-Q4_K_M.gguf
MMPROJ_PATH=@MODELS@/Qwen3.6-35B-A3B-mmproj-F16.gguf
ENABLE_MTP=0
NGL=99
# 1M YaRN. iso3 KV needs ~14GB on top of 20GB weights and OOMs a 32GB card.
CTX=1010000
PARALLEL=1
ROPE_SCALING=yarn
YARN_ORIG_CTX=262144
ROPE_SCALE=4
CACHE_TYPE_K=turbo2
CACHE_TYPE_V=turbo2
FLASH_ATTN=on
TEMP=0.7
TOP_P=0.80
TOP_K=20
REASONING_EFFORT=low
