# llama-server fast — copy to ~/ai-inference/config/llama-fast.env
MODEL_PATH=@MODELS@/Qwen3.6-35B-A3B-Q4_K_M.gguf
MMPROJ_PATH=@MODELS@/Qwen3.6-35B-A3B-mmproj-F16.gguf
ENABLE_MTP=0
NGL=99
CTX=262144
# 1M experiment (iso3 required). Uncomment and set CTX=1010000:
# CTX=1010000
# ROPE_SCALING=yarn
# YARN_ORIG_CTX=262144
# ROPE_SCALE=4
# IsoQuant 3-bit KV (scrya-com/rotorquant). q8_0 if llama-server --help lacks iso3.
CACHE_TYPE_K=iso3
CACHE_TYPE_V=iso3
FLASH_ATTN=on
TEMP=0.7
TOP_P=0.80
TOP_K=20
REASONING_EFFORT=low
