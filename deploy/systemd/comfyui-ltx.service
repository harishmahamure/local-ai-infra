[Unit]
Description=ComfyUI LTX-2.5 video+audio (separate install, port 8189)
After=network-online.target
Wants=network-online.target
Conflicts=llama-fast.service gemma.service comfyui.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@COMFY_LTX@
Environment=PYTHONUNBUFFERED=1
Environment=COMFYUI_HOME=@COMFY_LTX@
Environment=COMFYUI_MODELS=@HOME@/ComfyUI/models
Environment=COMFY_PORT=8189
ExecStartPre=@HOME@/ai-inference/control/scripts/remote/ensure-exclusive.sh comfyui-ltx.service
ExecStart=@HOME@/ai-inference/control/scripts/remote/comfyui.sh
KillMode=mixed
TimeoutStopSec=60
Restart=on-failure
RestartSec=10
StandardOutput=append:@HOME@/ai-inference/logs/comfyui-ltx.log
StandardError=append:@HOME@/ai-inference/logs/comfyui-ltx.log

[Install]
# Do not enable — start only via `ai start comfy-ltx` so one model occupies the GPU.
WantedBy=default.target
