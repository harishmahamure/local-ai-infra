<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-project.control</string>
  <key>ProgramArguments</key>
  <array>
    <string>@VENV@/bin/uvicorn</string>
    <string>control-api.mac_proxy:app</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>8090</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@ROOT@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>@ROOT@</string>
    <key>GPU_CONTROL_URL</key>
    <string>@GPU_CONTROL_URL@</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@ROOT@/logs/mac-control.log</string>
  <key>StandardErrorPath</key>
  <string>@ROOT@/logs/mac-control.log</string>
</dict>
</plist>
